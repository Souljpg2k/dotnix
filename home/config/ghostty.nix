{
  programs.ghostty = {
    enable = true;
    settings = {
      alpha-blending = "native";
      background-opacity = 0.5;
      bell-features = "no-title";
      command = "fish";
      copy-on-select = true;
      cursor-style = "block";
      cursor-style-blink = true;
      confirm-close-surface = false;
      font-family = "JetBrainsMono Nerd Font";
      font-size = 12;
      shell-integration-features = "no-cursor";
      theme = "TokyoNight";
      window-padding-x = 26;
      window-padding-y = 26;
    };
  };
}
